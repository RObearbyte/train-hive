# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Only the public URL and anon key belong here. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Where people download the app; it goes into the invitation message organizers share.
# Set this to your Play Store or APK download link once you have one (http or https).
# Leave it empty until then: the message then says "Ask me where to get the app".
EXPO_PUBLIC_APP_DOWNLOAD_URL=

# Where the web version of the app lives (http or https, no query string), for example https://trainhive.netlify.app
# When set, invitation messages start with a link that opens the web app with the code filled in
# (<this address>/join#code=ABCD-EFGH). Leave it empty if you do not publish the web version.
# Like all EXPO_PUBLIC_ variables it is baked in when the app is built (see docs/WEB_DEPLOY.md).
EXPO_PUBLIC_WEB_APP_URL=

# Legal details shown in the privacy notice and terms (public inside the app).
# The controller is the person or organization responsible for members' data.
EXPO_PUBLIC_CONTROLLER_NAME=
EXPO_PUBLIC_CONTROLLER_ADDRESS=
EXPO_PUBLIC_PRIVACY_EMAIL=
