# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Only the public URL and anon key belong here. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Where people download the app; it goes into the invitation message organizers share.
# Set this to your Play Store or APK download link once you have one (http or https).
# Leave it empty until then: the message then says "Ask me where to get the app".
EXPO_PUBLIC_APP_DOWNLOAD_URL=
