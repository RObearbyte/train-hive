{
  "expo": {
    "name": "TrainHive",
    "slug": "train-hive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trainhive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14263D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.robearbyte.trainhive",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "TrainHive",
      "shortName": "TrainHive",
      "lang": "en",
      "description": "TrainHive: see what is planned, say if you are in, and know for sure when a training is on.",
      "themeColor": "#14263D",
      "backgroundColor": "#14263D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14263D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#168F88",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14d5baef-10c1-4a49-9819-20382ccdb501"
      }
    },
    "owner": "robearbyte"
  }
}
